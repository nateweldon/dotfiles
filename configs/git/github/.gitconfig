[user]
	name = nateweldon
	email = nate.weldon@gmail.com

[credential]
	helper = manager
	modalPrompt = true

[http]
	sslVerify = false
[https]
	sslVerify = false

# Rewrite GitHub HTTPS URLs to SSH automatically
[url "git@github.com:"]
	insteadOf = https://github.com/
[apply]
    # do not warn about missing whitespace at EOF
    whitespace = nowarn

[core]
	autocrlf = true
	filemode = false
	excludesfile = ~/workspace/dotfiles/configs/git/.gitignore_global
	editor = code --wait
[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait $MERGED
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
